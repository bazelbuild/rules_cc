load("//cc:cc_test.bzl", "cc_test")
load(":masm_flags_test.bzl", "masm_flags_test")

licenses(["notice"])

# Compile MASM through the configured toolchain and call it from C++ to check
# assembly, linking, and propagation of preprocessor defines.
cc_test(
    name = "masm_test",
    size = "small",
    srcs = [
        "main.cc",
        "masm.asm",
    ],
    defines = ["MASM_TEST_VALUE=42"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ] + select({
        "//cc/compiler:clang-cl": [],
        "//cc/compiler:msvc-cl": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# MASM only warns about unsupported options, so also inspect the actual actions
# to make their reintroduction fail the test.
masm_flags_test(
    name = "masm_flags_test",
    target = ":masm_test",
)
