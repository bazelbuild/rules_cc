"""System library and header discovery."""

type _Attrs = struct[{
    "name": str,
    "includes": list[str],
    "hdrs": list[str],
    "optional_hdrs": list[str],
    "deps": list[str],
    "lib_path_hints": list[str],
    "static_lib_names": list[str],
    "shared_lib_names": list[str],
}, ...]

def _make_flags(flag_values: Collection[str] | None, flag: str) -> str: ...
def _split_env_var(repo_ctx: repository_ctx, var_name: str) -> dict[str, list[str]]: ...
def _get_list_from_env_var(repo_ctx: repository_ctx, var_name: str, key: str) -> list[str]: ...
def _execute_bash(repo_ctx: repository_ctx, cmd: str) -> str: ...
def _find_linker(repo_ctx: repository_ctx) -> str: ...
def _find_compiler(repo_ctx: repository_ctx) -> str: ...
def _find_lib_path(
        repo_ctx: repository_ctx,
        lib_name: str,
        archive_names: Collection[str],
        lib_path_hints: list[str],
) -> tuple[str, str] | tuple[None, None]: ...
def _find_header_path(
        repo_ctx: repository_ctx,
        lib_name: str,
        header_name: str,
        includes: list[str],
) -> str | None: ...
def _system_library_impl(repo_ctx: repository_ctx[_Attrs]) -> repo_metadata | None: ...
