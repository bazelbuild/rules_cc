"""Legacy feature and action configuration builders."""

load("//cc:cc_toolchain_config_lib.bzl", "ActionConfigInfo", "FeatureInfo")

type _ExistingNames = Collection[str] | str

type _Platform = Literal["linux", "mac"]

def get_legacy_features(
        ctx: ctx[object, struct[{"compiler": NotRequired[str]}, ...]],
        platform: _Platform,
        existing_feature_names: _ExistingNames,
        linker_tool_path: str,
) -> list[FeatureInfo]: ...

def get_features_to_appear_last(existing_feature_names: _ExistingNames) -> list[FeatureInfo]: ...

def get_legacy_action_configs(
        platform: _Platform,
        gcc_tool_path: str,
        ar_tool_path: str,
        strip_tool_path: str,
        existing_action_config_names: _ExistingNames,
) -> list[ActionConfigInfo]: ...

def _platform_specific_value[L, M](platform: str, *, linux: L, mac: M) -> L | M: ...
