"""Types for Objective-C compilation artifacts."""

type _Files = list[File] | tuple[File, ...]
type _ArchiveFactory = struct[{"archive": Callable[[], File]}, ...]
# TODO(https://github.com/bazelbuild/bazel/issues/31770): annotate the Objective-C artifact dictionary
# in Starlark once Bazel supports dictionaries with named, typed keys.
type _Result = dict[{
    "srcs": _Files | None,
    "non_arc_srcs": _Files | None,
    "additional_hdrs": _Files | None,
    "archive": File | None,
}]

def _compilation_artifacts_init(
    ctx: ctx[object, object] | None = ...,
    srcs: _Files | None = ...,
    non_arc_srcs: _Files | None = ...,
    hdrs: _Files | None = ...,
    intermediate_artifacts: _ArchiveFactory | None = ...,
) -> _Result: ...

def CompilationArtifactsInfo(
    ctx: ctx[object, object] | None = ...,
    srcs: _Files | None = ...,
    non_arc_srcs: _Files | None = ...,
    hdrs: _Files | None = ...,
    intermediate_artifacts: _ArchiveFactory | None = ...,
) -> record[{
    "srcs": _Files | None,
    "non_arc_srcs": _Files | None,
    "additional_hdrs": _Files | None,
    "archive": File | None,
}]: ...
