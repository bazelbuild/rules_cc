"""Conversion from rule-based toolchain providers to legacy configuration values."""

load("//cc:cc_toolchain_config_lib.bzli", "ActionConfigInfo", "ArtifactNamePatternInfo", "EnvSetInfo", "FeatureInfo", "FlagSetInfo", "MakeVariableInfo", "ToolInfo", "ToolPathInfo", "WithFeatureSetInfo")
load("//cc/toolchains:cc_toolchain_info.bzli", "ActionTypeInfo", "ArgsInfo", "FeatureConstraintInfo", "ToolConfigInfo", "ToolCapabilityInfo", "ToolchainConfigInfo", NewFeatureInfo = "FeatureInfo", NewToolInfo = "ToolInfo")

type LegacyArgs = struct[{"flag_sets": list[FlagSetInfo], "env_sets": list[EnvSetInfo]}]
type LegacyToolchain = struct[{
    "features": list[FeatureInfo],
    "action_configs": list[ActionConfigInfo],
    "cxx_builtin_include_directories": list[str],
    "artifact_name_patterns": list[ArtifactNamePatternInfo],
    "make_variables": list[MakeVariableInfo],
    "tool_paths": list[ToolPathInfo],
}]

def _convert_actions(actions: depset[ActionTypeInfo]) -> list[str]: ...
def convert_feature_constraint(constraint: FeatureConstraintInfo) -> WithFeatureSetInfo: ...
def convert_args(args: ArgsInfo, strip_actions: bool = ...) -> LegacyArgs: ...
def _convert_args_sequence(args_sequence: Sequence[ArgsInfo], strip_actions: bool = ...) -> LegacyArgs: ...
def _convert_tool_env(tool: NewToolInfo, action_name: str) -> EnvSetInfo | None: ...
def convert_feature(feature: NewFeatureInfo, enabled: bool = ...) -> FeatureInfo | None: ...
def convert_tool(tool: NewToolInfo) -> ToolInfo: ...
def convert_capability(capability: NewFeatureInfo) -> FeatureInfo: ...
def _convert_tool_map(tool_map: ToolConfigInfo, args_by_action: dict[str, LegacyArgs]) -> tuple[list[ActionConfigInfo], list[FeatureInfo]]: ...
def convert_toolchain(toolchain: ToolchainConfigInfo) -> LegacyToolchain: ...
