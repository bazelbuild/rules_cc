"""Contracts for complete provider values produced by the configuration helpers.

ActionConfigInfo also accepts the optional legacy config_name field.
"""

def _check_is_none(obj: object, parameter_name: str, method_name: str) -> None: ...

def _check_is_none_or_right_type(
        obj: object,
        obj_of_right_type: object,
        parameter_name: str,
        method_name: str,
) -> None: ...

def _check_right_type(
        obj: object,
        expected_type: str,
        parameter_name: str,
        method_name: str,
) -> None: ...

def _check_same_type(
        obj: object,
        obj_of_right_type: object,
        parameter_name: str,
        method_name: str,
) -> None: ...

def _check_is_nonempty_string(obj: object, parameter_name: str, method_name: str) -> None: ...

def _check_is_nonempty_list[T](obj: list[T], parameter_name: str, method_name: str) -> None: ...

def _is_gcc_compiler(compiler: str) -> bool: ...

def get_profile_correction_flags(ctx: ctx) -> list[str]: ...

def env_entry(key: str, value: str, expand_if_available: str | None = ...) -> EnvEntryInfo: ...

def variable_with_value(name: str, value: str) -> VariableWithValueInfo: ...

def make_variable(name: str, value: str) -> MakeVariableInfo: ...

def feature_set(features: list[str] = ...) -> FeatureSetInfo: ...

def with_feature_set(features: list[str] = ..., not_features: list[str] = ...) -> WithFeatureSetInfo: ...

def env_set(
        actions: list[str],
        env_entries: list[EnvEntryInfo] = ...,
        with_features: list[WithFeatureSetInfo] = ...,
) -> EnvSetInfo: ...

def flag_group(
        flags: list[str] = ...,
        flag_groups: list[FlagGroupInfo] = ...,
        iterate_over: str | None = ...,
        expand_if_available: str | None = ...,
        expand_if_not_available: str | None = ...,
        expand_if_true: str | None = ...,
        expand_if_false: str | None = ...,
        expand_if_equal: VariableWithValueInfo | None = ...,
) -> FlagGroupInfo: ...

def flag_set(
        actions: list[str] = ...,
        with_features: list[WithFeatureSetInfo] = ...,
        flag_groups: list[FlagGroupInfo] = ...,
) -> FlagSetInfo: ...

def feature(
        name: str,
        enabled: bool = ...,
        flag_sets: list[FlagSetInfo] = ...,
        env_sets: list[EnvSetInfo] = ...,
        requires: list[FeatureSetInfo] = ...,
        implies: list[str] = ...,
        provides: list[str] = ...,
) -> FeatureInfo: ...

def tool_path(name: str, path: str) -> ToolPathInfo: ...

def tool(
        path: str | None = ...,
        with_features: list[WithFeatureSetInfo] = ...,
        execution_requirements: list[str] = ...,
        tool: File | None = ...,
) -> ToolInfo: ...

def action_config(
        action_name: str,
        enabled: bool = ...,
        tools: list[ToolInfo] = ...,
        flag_sets: list[FlagSetInfo] = ...,
        implies: list[str] = ...,
) -> ActionConfigInfo: ...

def artifact_name_pattern(
        category_name: str,
        prefix: str | None,
        extension: str | None,
) -> ArtifactNamePatternInfo: ...

def EnvEntryInfo(
        *,
        key: str,
        value: str,
        expand_if_available: str | None,
        type_name: Literal["env_entry"],
) -> record[{
    "key": str,
    "value": str,
    "expand_if_available": str | None,
    "type_name": Literal["env_entry"],
}]: ...

def VariableWithValueInfo(
        *,
        name: str,
        value: str,
        type_name: Literal["variable_with_value"],
) -> record[{
    "name": str,
    "value": str,
    "type_name": Literal["variable_with_value"],
}]: ...

def MakeVariableInfo(
        *,
        name: str,
        value: str,
        type_name: Literal["make_variable"],
) -> record[{
    "name": str,
    "value": str,
    "type_name": Literal["make_variable"],
}]: ...

def FeatureSetInfo(
        *,
        features: list[str],
        type_name: Literal["feature_set"],
) -> record[{
    "features": list[str],
    "type_name": Literal["feature_set"],
}]: ...

def WithFeatureSetInfo(
        *,
        features: list[str],
        not_features: list[str],
        type_name: Literal["with_feature_set"],
) -> record[{
    "features": list[str],
    "not_features": list[str],
    "type_name": Literal["with_feature_set"],
}]: ...

def EnvSetInfo(
        *,
        actions: list[str],
        env_entries: list[EnvEntryInfo],
        with_features: list[WithFeatureSetInfo],
        type_name: Literal["env_set"],
) -> record[{
    "actions": list[str],
    "env_entries": list[EnvEntryInfo],
    "with_features": list[WithFeatureSetInfo],
    "type_name": Literal["env_set"],
}]: ...

def FlagGroupInfo(
        *,
        flags: list[str],
        flag_groups: list[FlagGroupInfo],
        iterate_over: str | None,
        expand_if_available: str | None,
        expand_if_not_available: str | None,
        expand_if_true: str | None,
        expand_if_false: str | None,
        expand_if_equal: VariableWithValueInfo | None,
        type_name: Literal["flag_group"],
) -> record[{
    "flags": list[str],
    "flag_groups": list[FlagGroupInfo],
    "iterate_over": str | None,
    "expand_if_available": str | None,
    "expand_if_not_available": str | None,
    "expand_if_true": str | None,
    "expand_if_false": str | None,
    "expand_if_equal": VariableWithValueInfo | None,
    "type_name": Literal["flag_group"],
}]: ...

def FlagSetInfo(
        *,
        actions: list[str],
        with_features: list[WithFeatureSetInfo],
        flag_groups: list[FlagGroupInfo],
        type_name: Literal["flag_set"],
) -> record[{
    "actions": list[str],
    "with_features": list[WithFeatureSetInfo],
    "flag_groups": list[FlagGroupInfo],
    "type_name": Literal["flag_set"],
}]: ...

def FeatureInfo(
        *,
        name: str,
        enabled: bool,
        flag_sets: list[FlagSetInfo],
        env_sets: list[EnvSetInfo],
        requires: list[FeatureSetInfo],
        implies: list[str],
        provides: list[str],
        type_name: Literal["feature"],
) -> record[{
    "name": str,
    "enabled": bool,
    "flag_sets": list[FlagSetInfo],
    "env_sets": list[EnvSetInfo],
    "requires": list[FeatureSetInfo],
    "implies": list[str],
    "provides": list[str],
    "type_name": Literal["feature"],
}]: ...

def ToolPathInfo(
        *,
        name: str,
        path: str,
        type_name: Literal["tool_path"],
) -> record[{
    "name": str,
    "path": str,
    "type_name": Literal["tool_path"],
}]: ...

def ToolInfo(
        *,
        path: str | None,
        tool: File | None,
        with_features: list[WithFeatureSetInfo],
        execution_requirements: list[str],
        type_name: Literal["tool"],
) -> record[{
    "path": str | None,
    "tool": File | None,
    "with_features": list[WithFeatureSetInfo],
    "execution_requirements": list[str],
    "type_name": Literal["tool"],
}]: ...

def ActionConfigInfo(
        *,
        action_name: str,
        enabled: bool,
        tools: list[ToolInfo],
        flag_sets: list[FlagSetInfo],
        implies: list[str],
        type_name: Literal["action_config"],
        config_name: str = ...,
) -> record[{
    "action_name": str,
    "enabled": bool,
    "tools": list[ToolInfo],
    "flag_sets": list[FlagSetInfo],
    "implies": list[str],
    "type_name": Literal["action_config"],
}, ...]: ...

def ArtifactNamePatternInfo(
        *,
        category_name: str,
        prefix: str | None,
        extension: str | None,
        type_name: Literal["artifact_name_pattern"],
) -> record[{
    "category_name": str,
    "prefix": str | None,
    "extension": str | None,
    "type_name": Literal["artifact_name_pattern"],
}]: ...
